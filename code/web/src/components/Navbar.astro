---
import AdminNav from './AdminNav.astro';
import GithubIcon from './Icons/Github.astro';
import InstagramIcon from './Icons/Instagram.astro';
import LinkedinIcon from './Icons/Linkedin.astro';
import TwitterIcon from './Icons/Twitter.astro';

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
---
<nav id="navbar" class="mx-auto flex flex-col items-center gap-2 text-slate-500 dark:text-white">
	<a
		href="/"
		data-admin-shortcut
		class="min-w-[10rem] border-b py-2 text-center uppercase dark:text-white"
	>
		{isHome ? 'Nicholas Romero' : 'Home'}
	</a>
	{isHome && (
		<div class="flex justify-center gap-4 uppercase">
			<a href="/posts">Posts</a>
			<a href="/projects">Projects</a>
			<a href="/about">About</a>
		</div>
	)}
	{isHome && (
		<div class="flex justify-center gap-4">
			<a href="https://www.linkedin.com/in/ncrmro/" aria-label="Linkedin profile">
				<LinkedinIcon class="fill-current text-gray-300" />
			</a>
			<a href="https://github.com/ncrmro" aria-label="Github profile" rel="me">
				<GithubIcon class="fill-current text-gray-300" />
			</a>
			<a href="https://twitter.com/ncrmro" aria-label="Twitter profile">
				<TwitterIcon class="fill-current text-gray-300" />
			</a>
			<a href="https://www.instagram.com/ncrmro" aria-label="Instagram profile">
				<InstagramIcon class="fill-current text-gray-300" />
			</a>
		</div>
	)}
<AdminNav server:defer />
</nav>

<script>
  const storageKey = "home-admin-shortcut";
  let clicks = 0;
  let lastClick = 0;
  try {
    const saved = JSON.parse(sessionStorage.getItem(storageKey) ?? "null");
    if (Number.isInteger(saved?.clicks) && saved.clicks > 0 && saved.clicks < 5 && typeof saved.at === "number") {
      clicks = saved.clicks;
      lastClick = saved.at;
    }
  } catch { /* Normal navigation still works when storage is unavailable. */ }

  document.addEventListener("click", (event) => {
    const home = event.target instanceof Element && event.target.closest("[data-admin-shortcut]");
    const now = Date.now();
    const eligible = home && event.button === 0 && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey;
    clicks = eligible ? (now - lastClick <= 10000 ? clicks + 1 : 1) : 0;
    lastClick = now;
    try {
      if (clicks > 0 && clicks < 5) sessionStorage.setItem(storageKey, JSON.stringify({ clicks, at: now }));
      else sessionStorage.removeItem(storageKey);
    } catch { /* Do not interfere with the link if storage is blocked. */ }
    if (clicks === 5) {
      event.preventDefault();
      window.location.assign("/admin");
    } else if (eligible && window.location.pathname === "/") {
      event.preventDefault();
      window.scrollTo(0, 0);
    }
  });
</script>
