---
import PostListItem from './PostListItem.astro';
import { writingPosts } from '../writing/public-posts';
interface Props {
	tag: string;
}

const { tag } = Astro.props;
const posts = (await writingPosts(Astro.url.origin, Astro.cache)).filter(post => post.data.tags.includes(tag)).sort((a,b) => b.data.publish_date.valueOf() - a.data.publish_date.valueOf());
---
{posts.length === 0 ? (
	<p class="text-gray-500 dark:text-gray-400">No posts yet.</p>
) : (
	<ul role="list" class="-mb-8 w-full md:max-w-3xl">
		{posts.map((post) => (
			<PostListItem
				slug={post.slug}
				title={post.data.title}
				description={post.data.description}
				publish_date={post.data.publish_date}
				published={post.data.published}
			/>
		))}
	</ul>
)}
