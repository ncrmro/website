---
import BaseLayout from "../layouts/BaseLayout.astro";
import { canPublish } from "../writing/policy";
import { env } from "cloudflare:workers";
---
<BaseLayout title="Admin · Nicholas Romero" description="Manage posts">
  <section class="w-full max-w-4xl py-6" aria-labelledby="admin-heading">
    <header class="mb-6 flex flex-wrap items-center justify-between gap-4">
      <h1 id="admin-heading" class="text-xl font-semibold">Posts</h1>
      <nav aria-label="Post actions" class="flex gap-4 text-slate-500 dark:text-white">
        <a href="/admin/posts/new" data-new-document="posts">New post</a>
        <a href="/api/auth/signout">Sign out</a>
      </nav>
    </header>
    {!canPublish(Astro.url.hostname) && <p role="alert">This preview is read-only. Open ncrmro.com/admin to save and publish.</p>}
    {!env.SERVICE_TOKEN && <p role="alert">Writing is awaiting its repository connection. Configure SERVICE_TOKEN with access to this website repository to save and publish.</p>}
    {canPublish(Astro.url.hostname) && <section data-collection="posts" aria-label="Editable posts">
      <div class="listing-controls">
      <label>Search <input type="search" data-search placeholder="Title, tags, or text" /></label>
      <button type="button" data-refresh>Refresh from GitHub</button>
    </div>
    <p data-cache-status class="listing-cache-status"></p>
    <p role="status">Loading documents…</p>
      <ul class="admin-post-list"></ul>
    </section>}
  </section>
  <script>
    import { mountDocumentList } from "../writing/document-list";
    import { wireNewLinks } from "../writing/navigation";
    wireNewLinks();
    document.querySelectorAll<HTMLElement>("[data-collection]").forEach(mountDocumentList);
  </script>
</BaseLayout>

<style is:global>
  .admin-post-list { margin-top: 1rem; }
  .admin-post-list li + li { border-top: 1px solid var(--border); }
  .admin-post-list a { display: flex; align-items: flex-start; gap: 1rem; padding: 1rem 0; }
  .admin-post-list a > div { min-width: 0; flex: 1; overflow-wrap: anywhere; }
  .admin-post-list h2 { font-size: 1.125rem; font-weight: 600; }
  .admin-post-list .post-meta { color: var(--muted); font-size: .875rem; margin-top: .25rem; }
  .admin-post-list .post-description { margin-top: .5rem; }
  .admin-post-list img { width: 100px; height: 70px; flex: none; object-fit: cover; border-radius: .25rem; }
  @media (min-width: 640px) { .admin-post-list img { width: 160px; height: 112px; } }
  .listing-controls { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; margin-top: 1rem; }
  .listing-controls label { flex: 1; min-width: 12rem; }
  .listing-controls input { width: 100%; box-sizing: border-box; padding: .5rem; border: 1px solid var(--border); border-radius: .25rem; background: var(--page); color: var(--text); }
  .listing-controls button { padding: .5rem; border: 1px solid var(--border); border-radius: .25rem; cursor: pointer; }
  .listing-controls button:disabled { opacity: .6; cursor: wait; }
  .listing-cache-status { color: var(--muted); font-size: .875rem; margin-top: .75rem; }
</style>
