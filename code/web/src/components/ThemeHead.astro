<meta name="color-scheme" content="light dark">
<script is:inline>
// Run before first paint, including on cached public pages.
try {
  const theme = localStorage.getItem("website-theme") ?? localStorage.getItem("quiescent-theme");
  if (theme === "light" || theme === "dark") localStorage.setItem("website-theme", theme);
  localStorage.removeItem("quiescent-theme");
  if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
} catch {
  /* Device storage may be unavailable; follow the system. */
}
</script>
