---
import BaseHead from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: string;
	bodyClass?: string;
	fullScreen?: boolean;
}

const { title, description, image, type, publishedTime, bodyClass, fullScreen = false } = Astro.props;
---
<!doctype html>
<html lang="en" class="dark:bg-gray-900 dark:text-white">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			type={type}
			publishedTime={publishedTime}
		/>
	</head>
	<body class={bodyClass}>
		<main class:list={["flex w-full flex-col items-center", { "p-4": !fullScreen }]}>
			{!fullScreen && <Navbar />}
			<slot />
		</main>
	</body>
</html>
