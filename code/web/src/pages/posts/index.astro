---
import { publicSlug } from "../../writing/policy";
import { writingPosts } from '../../writing/public-posts';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListItem from '../../components/PostListItem.astro';
import { isVisibleInLocalDevelopment } from '../../lib/posts';

const posts = [...await getCollection('blog', isVisibleInLocalDevelopment), ...await writingPosts(Astro.url.origin, Astro.cache)]
	.sort((a, b) => (b.data.publish_date?.valueOf() ?? 0) - (a.data.publish_date?.valueOf() ?? 0));
---
<BaseLayout title="Posts" description="Blog posts by Nicholas Romero">
	<ul role="list" class="-mb-8 w-full md:max-w-3xl">
		{posts.map((post) => (
			<PostListItem
				slug={publicSlug(post)}
				href={post.data.published && !post.data.draft ? `/posts/${publicSlug(post)}/` : `/drafts/${publicSlug(post)}`}
				title={post.data.title}
				description={post.data.description}
				publish_date={post.data.publish_date}
				published={post.data.published && !post.data.draft}
			/>
		))}
	</ul>
</BaseLayout>
