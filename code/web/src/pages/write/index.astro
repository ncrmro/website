---
import SiteNav from "../../components/SiteNav.astro";
import ThemeHead from "../../components/ThemeHead.astro";
import { canPublish } from "../../writing/policy";
import { env } from "cloudflare:workers";
export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <ThemeHead />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <title>Documents · Quiescent</title>
  </head>
  <body>
    <SiteNav editing />
    <main>
      <a href="/">Read stories</a>
      <h1>Your documents</h1>
      {!canPublish(Astro.url.hostname) && <p role="alert">This preview is read-only. Open ncrmro.com/write to save and publish.</p>}
      {!env.SERVICE_TOKEN && <p role="alert">Writing is awaiting its repository connection. Configure SERVICE_TOKEN with access to this website repository to save and publish.</p>}
      {(canPublish(Astro.url.hostname) ? ["posts"] : []).map((collection) => (
  <section data-collection={collection}>
    <h2>{collection === "posts" ? "Posts" : "Recipes"}</h2>
    <a href={`/${collection}/new`} data-new-document={collection}>
      New {collection === "posts" ? "post" : "recipe"}
    </a>
    <p role="status">Loading documents…</p>
    <ul></ul>
  </section>
))}
    </main>
    <script>
    import { mountDocumentList } from "../../writing/document-list";
    import { wireNewLinks } from "../../writing/navigation";

    wireNewLinks();
    document.querySelectorAll<HTMLElement>("[data-collection]").forEach(mountDocumentList);
    </script>
    <style>
    :global(body) {
      margin: 0;
      background: var(--page);
      color: var(--text);
      font:
        16px / 1.6 system-ui,
        sans-serif;
    }
    main {
      max-width: 850px;
      margin: auto;
      padding: 2rem;
    }
    section {
      margin-block: 2rem;
    }
    a {
      color: var(--accent);
    }
    ul {
      padding-left: 1.2rem;
    }
    li {
      margin-block: 0.6rem;
    }
    </style>
  </body>
</html>
