{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ncrmro-website",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-13",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "WRITING_MEDIA",
      "bucket_name": "ncrmro-website-quiescent-media"
    }
  ],
  "services": [
    {
      "binding": "WRITING_SELF",
      "service": "ncrmro-website"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "AUTH_URL": "https://ncrmro.com/api/auth",
    "AUTH_REDIRECT_PROXY_URL": "https://ncrmro.com/api/auth"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "WRITING_CACHE",
      "database_name": "ncrmro-website-document-cache",
      "database_id": "aae5ac8a-b9d6-4b15-8c2c-2a0eafb09ed1"
    }
  ]
}
