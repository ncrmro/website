{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ncrmro-website",
	// Custom entry adds the scheduled handler for quiescent's cron draft flush.
	"main": "./src/worker.ts",
	"compatibility_date": "2026-05-13",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{ "binding": "SESSIONS", "id": "59da8c5e261e46e495ec1ea351fe87e2" },
		{ "binding": "DRAFTS", "id": "284c39a3c527423d823a9c88ba0234a8" }
	],
	"triggers": {
		// Flush drafts abandoned mid-edit onto the user's quiescent PR branch.
		"crons": ["*/5 * * * *"]
	},
	"vars": {
		"AUTH_URL": "https://ncrmro.com/api/auth",
		"AUTH_REDIRECT_PROXY_URL": "https://ncrmro.com/api/auth",
		"FORGE_KIND": "github",
		"REPO_OWNER": "ncrmro",
		"REPO_NAME": "website",
		"DEFAULT_BRANCH": "main",
		"OAUTH_CALLBACK_PATH": "/admin/auth/callback",
		// Verified GitHub emails allowed into /admin (comma-separated).
		"ADMIN_EMAILS": "ncrmro@gmail.com",
		// Every flush opens/updates a PR — nothing commits straight to main.
		"FLUSH_MODE": "pull-request"
	},
	"observability": {
		"enabled": true
	}
}
